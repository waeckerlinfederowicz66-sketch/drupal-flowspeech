{
  "name": "drupal/flowspeech",
  "description": "Provides FlowSpeech public API v1 text-to-speech jobs through the Drupal AI module.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://flowspeech.io/",
  "authors": [
    {
      "name": "FlowSpeech",
      "email": "support@flowspeech.io"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "drupal/ai": "^1.0.5",
    "drupal/key": "^1.18"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\flowspeech\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\flowspeech\\Unit\\": "tests/src/Unit/"
    }
  },
  "scripts": {
    "test:contract": "php tests/provider.php"
  },
  "archive": {
    "exclude": ["/tests", "/scripts", "/dist", "/.tools", "/.github", "/RELEASE_REPORT.md", "/phpunit.xml.dist"]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": false,
      "symfony/runtime": true
    }
  }
}
